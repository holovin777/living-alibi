; Living Alibi — first visual park prototype.
; The Java engine and local Spring Boot server remain authoritative.
config_version=5

[application]
config/name="Living Alibi"
run/main_scene="res://scenes/park.tscn"

[audio]
general/text_to_speech=true
driver/enable_input=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
